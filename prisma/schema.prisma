generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  MEMBER
}

enum CredentialKind {
  USER
  SERVICE
}

model User {
  id                 String    @id @default(cuid())
  username           String    @unique
  passwordHash       String
  role               Role      @default(MEMBER)
  totpSecret         String? // encrypted, AAD "totp:<userId>"
  totpLastStep       Int? // last accepted TOTP time step, blocks code replay
  mustChangePassword Boolean   @default(true)
  disabled           Boolean   @default(false)
  createdAt          DateTime  @default(now())
  lastLoginAt        DateTime?

  sessions          Session[]
  updatedCreds      Credential[]        @relation("CredentialUpdatedBy")
  historyChanges    CredentialHistory[]
  auditLogs         AuditLog[]
  artifacts         Artifact[]
}

model Session {
  id        String   @id // sha256 of the session token
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  // false until the TOTP step is completed for users with 2FA enabled
  verified  Boolean  @default(false)
  createdAt DateTime @default(now())
  expiresAt DateTime
  ip        String?
  userAgent String?

  @@index([userId])
}

model Box {
  id        String   @id @default(cuid())
  name      String   @unique
  address   String?
  os        String?
  notes     String?
  createdAt DateTime @default(now())

  // Public artifact links are /d/<token>/<filename>; one token per box so a
  // tool can fetch edr.conf and then edr.conf.sig from the same base URL.
  // Looked up by hash, kept encrypted (AAD "box-token:<id>") for display.
  publicTokenHash String? @unique
  publicToken     String?

  credentials Credential[]
  artifacts   Artifact[]
}

model Credential {
  id          String         @id @default(cuid())
  boxId       String
  box         Box            @relation(fields: [boxId], references: [id], onDelete: Cascade)
  kind        CredentialKind @default(USER)
  service     String         @default("")
  username    String
  secret      String // encrypted blob, see src/lib/crypto.ts
  notes       String?
  version     Int            @default(1)
  updatedById String?
  updatedBy   User?          @relation("CredentialUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  history CredentialHistory[]

  @@unique([boxId, service, username])
}

model CredentialHistory {
  id           String     @id @default(cuid())
  credentialId String
  credential   Credential @relation(fields: [credentialId], references: [id], onDelete: Cascade)
  secret       String
  version      Int
  changedById  String?
  changedBy    User?      @relation(fields: [changedById], references: [id], onDelete: SetNull)
  changedAt    DateTime   @default(now())

  @@index([credentialId])
}

model AuditLog {
  id         String   @id @default(cuid())
  userId     String?
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  username   String? // denormalized so failed logins / deleted users stay readable
  action     String
  targetType String?
  targetId   String?
  summary    String?
  ip         String?
  meta       Json?
  at         DateTime @default(now())

  @@index([at])
  @@index([targetType, targetId])
}

model Artifact {
  id              String    @id @default(cuid())
  name            String // sanitized original filename
  contentType     String // as reported by the uploader; display only, never served
  size            Int
  sha256          String // of the plaintext
  notes           String?
  boxId           String?
  box             Box?      @relation(fields: [boxId], references: [id], onDelete: SetNull)
  uploadedById    String?
  uploadedBy      User?     @relation(fields: [uploadedById], references: [id], onDelete: SetNull)
  // Reachable at /d/<box token>/<name> while true, unexpired and on a box.
  public          Boolean   @default(false)
  publicExpiresAt DateTime?
  publicHits      Int       @default(0)
  createdAt       DateTime  @default(now())

  blob ArtifactBlob?

  // Uploading the same name to the same box replaces the file. Postgres
  // doesn't treat NULLs as equal, so boxless names are kept unique in code.
  @@unique([boxId, name])
}

// Kept apart from Artifact so listing artifacts can never pull file bytes.
model ArtifactBlob {
  artifactId String   @id
  artifact   Artifact @relation(fields: [artifactId], references: [id], onDelete: Cascade)
  data       Bytes // encrypted, AAD "artifact:<id>", see encryptBytes in src/lib/crypto.ts
}
