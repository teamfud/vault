# Postgres connection string (Railway: ${{Postgres.DATABASE_URL}})
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/vault
# 32 random bytes, base64. Generate with: npm run gen-key
# LOSING THIS KEY MAKES EVERY STORED SECRET UNRECOVERABLE.
VAULT_MASTER_KEY=
# First-boot admin account, only used when the users table is empty
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
